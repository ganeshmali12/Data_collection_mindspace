# Security Settings
SECRET_KEY=change-me-to-a-secure-random-value-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Database Settings
# Set DB_ENGINE to 'postgresql' or 'sqlite'
DB_ENGINE=postgresql
DB_NAME=mindspace_collection
DB_USER=mindspace_user
DB_PASSWORD=mindspace_local_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Application Bind Configuration
DATA_COLLECTION_BIND_IP=127.0.0.1
DATA_COLLECTION_PORT=8000

# Face ML Services
FACE_EXTRACT_URL=http://100.68.80.72:5100/extract/video
FACE_EXTRACT_SESSION_VECTOR_URL_TEMPLATE=http://100.68.80.72:5100/extract/session/{session_id}/vector
FACE_SCORE_URL=http://100.68.80.72:5200/score
FACE_VIDEO_FEATURE_EXTRACTION_API_KEY=your_face_extract_api_key
FACE_VIDEO_FEATURE_TO_MH_API_KEY=your_face_score_api_key

# Text ML & Speech-to-Text Services
TEXT_EXTRACT_URL=http://100.68.80.72:8025/analyze
TEXT_SCORE_URL=http://100.68.80.72:5500/predict
TEXT_PARAMETER_EXTRACT_API_KEY=your_text_extract_api_key
TEXT_ANALYSIS_API_KEY=your_text_score_api_key

SARVAM_API_KEY=your_sarvam_api_key
SARVAM_STT_MODEL=saaras:v3

# Voice ML Services
VOICE_EXTRACT_URL=http://100.68.80.72:5800/extract
VOICE_PCA_URL=http://100.68.80.72:5900/process
VOICE_SCORE_URL=http://100.68.80.72:5600/predict
VOICE_FEATURE_EXTRACT_API_KEY=your_voice_extract_api_key
VOICE_PCA_API_KEY=your_voice_pca_api_key
VOICE_FEATURE_TO_MH=your_voice_score_api_key

# Multimodal Fusion Service
FUSION_SCORE_URL=http://100.68.80.72:8010/predict
FUSION_API_KEY=your_fusion_api_key
